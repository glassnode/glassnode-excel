{
  "name": "excel-custom-functions",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/OfficeDev/Excel-Custom-Functions.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "prestart": "npm run build",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "lint": "eslint 'src/**/*.{ts,tsx}' --fix",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.xml",
    "start:web": "office-addin-debugging start manifest.xml --source web",
    "stop": "office-addin-debugging stop manifest.xml",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate": "office-addin-manifest validate manifest.xml",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "axios-cache-interceptor": "^1.13.0",
    "core-js": "^3.51.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^8.0.7",
    "@types/custom-functions-runtime": "^1.6.13",
    "@types/jest": "^30.0.0",
    "@types/office-js": "^1.0.617",
    "@types/office-runtime": "^1.0.40",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "acorn": "^8.19.0",
    "axios-mock-adapter": "^2.1.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "custom-functions-metadata-plugin": "^2.1.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-office-addins": "^4.0.3",
    "eslint-plugin-prettier": "^5.5.7",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "office-addin-cli": "^2.0.3",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^2.0.3",
    "office-addin-lint": "^3.0.3",
    "office-addin-manifest": "^3.0.1",
    "office-addin-prettier-config": "^2.0.1",
    "os-browserify": "^0.3.0",
    "prettier": "^3.10.1",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.4.2",
    "webpack": "^5.113.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "5.2.6"
  },
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ],
  "engines": {
    "node": ">=26.13.1"
  }
}
